<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <!-- Keep the Angular source project out of the C# build/watch. wwwroot is
         left alone so the Web SDK picks it up as static web assets. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Build the Angular app into wwwroot/ before the .NET build enumerates
       static web assets. Runs on a fresh checkout (no wwwroot yet) and always
       for a Release build so `dotnet publish` ships a current bundle. For
       day-to-day dev, skip it and use `npm start` (ng serve) alongside
       `dotnet watch`. Force a rebuild any time with -p:BuildClientApp=true. -->
  <Target Name="BuildClientApp"
          BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths;Build"
          Condition="'$(BuildClientApp)' == 'true' Or '$(Configuration)' == 'Release' Or !Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)"
          Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>
