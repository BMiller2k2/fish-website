# Copy this file to ".env" and fill in your key. Loaded at startup by Program.cs
# (real environment variables take precedence).

# Required for the chatbot. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Optional overrides:
# GEMINI_MODEL=gemini-3.6-flash
# DB_FILE=data/fishfinder.db
# ASPNETCORE_URLS=http://localhost:5152

# Optional: if set, admin writes require this token and /admin needs sign-in.
# Leave unset for local development.
# ADMIN_TOKEN=some-long-random-string
